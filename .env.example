DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set a NEW passcode; the previous value was committed publicly.
OARC_PASSCODE=
# Comma-separated authorized school email addresses
OARC_ALLOWED_EMAILS=
# Generate a random secret of at least 32 characters
SESSION_SECRET=
# Optional: comma-separated frontend origins for a separate API host
CORS_ORIGINS=
